---
import '../../styles/glossary.css';
import Base from '../../layouts/Base.astro';
import GlossaryList from '../../islands/GlossaryList';
import { SITE, formatBytes, library, publishedBytes } from '../../lib/data';
import { CSV_TABLES } from '../../lib/downloads';
import { glossaryCategories, glossaryRows } from '../../lib/glossary';

const lib = library();
const rows = glossaryRows();
const categories = glossaryCategories();
const files = CSV_TABLES.filter(([name]) => name.startsWith('glossary'));
const named = rows.filter((row) => row.schemes.length > 0).length;
---

<Base
  title="Glossary"
  description={`${rows.length} football terms from the play sheets, A to Z: blocking schemes, runs, passes, fronts, coverages and reads, with other names for each and the schemes that use them.`}
>
  <div class="wrap">
    <nav aria-label="Breadcrumb" class="crumbs">
      <a href="/">Cover</a>
      <span class="sep"><span aria-hidden="true">/</span><span aria-current="page">Glossary</span></span>
    </nav>
  </div>
  <section class="wrap section" style="padding-top:8px;gap:20px">
    <div style="display:flex;flex-direction:column;gap:14px;padding-bottom:8px">
      <p class="eyebrow">Glossary · A to Z</p>
      <h1 class="page-title">The {rows.length} terms</h1>
      <p class="body" style="font-size:18px;line-height:28px">
        The words the play sheets use: blocking schemes, runs, passes, fronts, coverages and reads. Each entry gives the meaning, a tactical note, the other names the term goes by and the <a href="/schemes/">schemes</a> whose plays name it.
      </p>
    </div>
    <GlossaryList client:load rows={rows} categories={categories} />
    <p class="type" style="font-size:12px;line-height:18px;color:var(--fg2);max-width:760px">
      A scheme is listed under a term when one of its plays names the term, or another name for it, in its title, formation, front or coverage. {named} of the {rows.length} terms are named that way today. Spot a mistake? <a href="/about/#corrections">Send a correction</a>.
    </p>
  </section>

  <section class="wrap section" style="padding-bottom:64px">
    <div class="divider"><p class="eyebrow">Data</p><h2>Take the terms with you</h2><p class="aside">{SITE.dataLicense}</p></div>
    <div class="dl-list" style="max-width:820px">
      {files.map(([name, note]) => {
        const href = `/downloads/csv/${name}.csv`;
        return <a class="dl" href={href}><span><span class="type" style="font-weight:700">{name}.csv</span> <span style="color:var(--fg2);font-size:14px">{note}</span></span><span class="fmt">{formatBytes(publishedBytes(href))}</span></a>;
      })}
      <a class="dl" href="/downloads/scheme-db.json"><span>Everything, nested, with the terms</span><span class="fmt">JSON {formatBytes(publishedBytes('/downloads/scheme-db.json'))}</span></a>
    </div>
    <p class="prose" style="max-width:680px">
      The {lib.counts.terms} terms are part of the open data, so you can build on them. See <a href="/data/">the Data page</a> for the other formats, the schema and how to credit SchemeDB.
    </p>
  </section>
</Base>
