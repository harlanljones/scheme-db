# Read by Cloudflare Workers static assets when it serves dist/. Not served itself.

# Files in /_astro/ are named by a hash of their content, so one name never changes: cache them for a year.
# Everything else keeps Cloudflare's default (revalidate every time), so a new build shows at once.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cloudflare has no content type for .sqlite, so a browser has to guess.
/downloads/scheme-db.sqlite
  Content-Type: application/vnd.sqlite3
