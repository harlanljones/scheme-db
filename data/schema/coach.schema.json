{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "role2026": {
      "type": "string",
      "minLength": 1
    },
    "team": {
      "type": "string",
      "minLength": 1
    },
    "lineage": {
      "type": "string",
      "enum": [
        "shanahan-kubiak",
        "reid-west-coast",
        "power-gap-duo",
        "macdonald-pressure",
        "fangio-two-high",
        "carroll-saleh-wide9",
        "belichick-flores",
        "coryell-vertical",
        "air-raid",
        "option-spread",
        "delaware-wing-t",
        "buddy-46",
        "lebeau-zone-blitz",
        "landry-dallas",
        "phillips-two-gap",
        "two-deep-shell",
        "college-defensive-fronts"
      ]
    },
    "mentorId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "disciples": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "side": {
      "type": "string",
      "enum": [
        "offense",
        "defense"
      ]
    },
    "philosophy": {
      "type": "string",
      "minLength": 1
    },
    "keyConcepts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "schemeIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "isHeadCoach2026": {
      "type": "boolean"
    },
    "notableAchievements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "asOf": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "film",
              "book",
              "clinic",
              "article",
              "video",
              "self-authored"
            ]
          },
          "citation": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "supports": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "idea",
                "drawing",
                "claim"
              ]
            }
          }
        },
        "required": [
          "type",
          "citation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "name",
    "role2026",
    "team",
    "lineage",
    "side",
    "philosophy",
    "keyConcepts",
    "schemeIds"
  ],
  "additionalProperties": false
}
