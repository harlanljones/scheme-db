{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "conceptId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "duration": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "generatedFrom": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "compiler": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "spec",
        "compiler"
      ],
      "additionalProperties": false
    },
    "offense": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "offense",
              "defense"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "ol",
              "qb",
              "rb",
              "te",
              "wr",
              "dl",
              "lb",
              "db"
            ]
          },
          "trail": {
            "type": "string",
            "enum": [
              "route",
              "block",
              "carry",
              "drop",
              "none"
            ]
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "enum": [
              "compiled",
              "authored"
            ]
          },
          "waypoints": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "t",
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "side",
          "role",
          "trail",
          "waypoints"
        ],
        "additionalProperties": false
      }
    },
    "defense": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "side": {
            "type": "string",
            "enum": [
              "offense",
              "defense"
            ]
          },
          "role": {
            "type": "string",
            "enum": [
              "ol",
              "qb",
              "rb",
              "te",
              "wr",
              "dl",
              "lb",
              "db"
            ]
          },
          "trail": {
            "type": "string",
            "enum": [
              "route",
              "block",
              "carry",
              "drop",
              "none"
            ]
          },
          "assignment": {
            "type": "string",
            "minLength": 1
          },
          "origin": {
            "type": "string",
            "enum": [
              "compiled",
              "authored"
            ]
          },
          "waypoints": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "t": {
                  "type": "number",
                  "minimum": 0
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "t",
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "side",
          "role",
          "trail",
          "waypoints"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "conceptId",
    "duration",
    "offense",
    "defense"
  ],
  "additionalProperties": false
}
