{
  "name": "scheme-db",
  "version": "1.0.0",
  "description": "A free, open database of football scheme strategy: schemes, plays, coaches and coaching lineages as JSON, CSV and SQLite, with an animated play viewer.",
  "author": "Harlan Jones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlanljones/scheme-db.git"
  },
  "homepage": "https://github.com/harlanljones/scheme-db#readme",
  "bugs": {
    "url": "https://github.com/harlanljones/scheme-db/issues"
  },
  "keywords": [
    "nfl",
    "football",
    "football-analytics",
    "scheme-database",
    "open-data",
    "play-diagrams",
    "svg-animation",
    "coaching-trees",
    "astro",
    "react",
    "typescript",
    "bun"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run site:assets && bun --bun astro dev",
    "build": "bun run site:assets && bun --bun astro build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "data:new": "bun run scripts/new.ts",
    "data:validate": "bun run scripts/data.ts validate",
    "data:format": "bun run scripts/data.ts format",
    "data:schema": "bun run scripts/data.ts schema",
    "data:frames": "bun run scripts/data.ts frames",
    "data:release": "bun run scripts/release.ts",
    "data:package": "bun run scripts/package-release.ts",
    "site:assets": "bun run scripts/site-assets.ts",
    "site:check": "bun run scripts/check-site.ts",
    "specs:check": "bun run scripts/specs.ts check",
    "specs:compile": "bun run scripts/specs.ts compile",
    "specs:diff": "bun run scripts/specs.ts diff",
    "speed:report": "bun run scripts/speed-report.ts",
    "lint": "oxlint",
    "check": "bun run data:validate && bun run data:format --check && bun run specs:check && bun run data:release --version ci && bun run data:package --version ci && bun run test && bun run typecheck && bun run build && bun run site:check",
    "preview": "bun --bun astro preview",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "astro": "^7.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.75.0",
    "satori": "^0.63.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
