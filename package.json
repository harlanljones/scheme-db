{
  "name": "scheme-db",
  "version": "1.0.0",
  "description": "Interactive NFL offensive & defensive scheme workstation with Catmull-Rom spline animation, 0.0s–1.2s disguise mesh analysis, and coaching lineage trees.",
  "author": "Harlan Jones",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harlanljones/scheme-db.git"
  },
  "homepage": "https://github.com/harlanljones/scheme-db#readme",
  "bugs": {
    "url": "https://github.com/harlanljones/scheme-db/issues"
  },
  "keywords": [
    "nfl",
    "football-analytics",
    "scheme-visualizer",
    "svg-animation",
    "catmull-rom",
    "react-19",
    "vite",
    "typescript",
    "coaching-trees",
    "all-22",
    "data-visualization"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run site:assets && bun --bun astro dev",
    "dev:legacy": "vite",
    "build": "bun run site:assets && bun --bun astro build",
    "build:legacy": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "data:migrate": "bun run scripts/migrate-legacy.ts",
    "data:validate": "bun run scripts/data.ts validate",
    "data:format": "bun run scripts/data.ts format",
    "data:schema": "bun run scripts/data.ts schema",
    "data:frames": "bun run scripts/data.ts frames",
    "data:release": "bun run scripts/release.ts",
    "site:assets": "bun run scripts/site-assets.ts",
    "site:check": "bun run scripts/check-site.ts",
    "specs:check": "bun run scripts/specs.ts check",
    "specs:compile": "bun run scripts/specs.ts compile",
    "specs:diff": "bun run scripts/specs.ts diff",
    "lint": "oxlint",
    "preview": "bun --bun astro preview",
    "preview:legacy": "vite preview",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.2",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/zilla-slab": "^5.3.0",
    "astro": "^7.4.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
