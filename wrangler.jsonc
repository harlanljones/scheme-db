{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scheme-db",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Old `/?play=...` links are told apart by their query string, so the Worker runs first for the home page only.
    // Every other request is served from dist/ without waking it.
    "run_worker_first": ["/", "/index.html"]
  }
}
